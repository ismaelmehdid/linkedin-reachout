# Unipile base URL, e.g. https://apiX.unipile.com:PORT
UNIPILE_DSN=
# Unipile API key, sent as X-API-KEY
UNIPILE_API_KEY=
# LinkedIn account id connected once in the Unipile dashboard
UNIPILE_ACCOUNT_ID=
# Neon connection string; pglite:<dir> uses a local PGlite database (development only)
DATABASE_URL=pglite:./.data/dev
# Dashboard login password
APP_PASSWORD=
# Secret required on /api/tick
CRON_SECRET=
# Secret expected in the Unipile-Auth header on webhook calls
WEBHOOK_SECRET=
# When true, no Unipile write endpoint is called
DRY_RUN=true
