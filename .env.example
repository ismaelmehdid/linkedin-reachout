# Unipile base URL, e.g. https://apiX.unipile.com:PORT
UNIPILE_DSN=
# Unipile API key, sent as X-API-KEY
UNIPILE_API_KEY=
# LinkedIn account id connected once in the Unipile dashboard
UNIPILE_ACCOUNT_ID=
# Neon connection string; pglite:<dir> uses a local PGlite database (development only)
DATABASE_URL=pglite:./.data/dev
# Dashboard login password, at least 16 characters; generate it with: openssl rand -base64 32
APP_PASSWORD=
# Secret required on /api/tick, at least 32 characters; generate it with: openssl rand -base64 32
CRON_SECRET=
# Secret expected in the Unipile-Auth header on webhook calls, at least 32 characters; generate it with: openssl rand -base64 32
WEBHOOK_SECRET=
# Required: true or false. When true, no Unipile write endpoint is called. With any other value, or none, every request fails as misconfigured
DRY_RUN=true
# Optional: OpenAI API key used only to write the AI drafts; without it the app runs and only draft generation reports it missing
OPENAI_API_KEY=
# Optional: OpenAI model for the drafts (default gpt-6.2-astra)
OPENAI_MODEL=gpt-6.2-astra
